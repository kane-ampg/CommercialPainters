# ---------------------------------------------------------------
# Commercial Painters — environment configuration
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------

# Canonical origin used for metadataBase, canonicals, sitemap and JSON-LD.
# Production: "https://commercialpaintersau.com.au". A production build with no
# origin at all fails rather than shipping localhost canonicals.
#
# Server-only: no NEXT_PUBLIC_ prefix, so the value is never inlined into a
# browser bundle. Only server components, route handlers, robots.ts and
# sitemap.ts read it. Reading it from a client component would render
# localhost in the browser and mismatch hydration — don't.
SITE_URL="http://localhost:3000"

# Staging lockdown. "true" turns every noindex layer on together — the meta
# robots directive, the X-Robots-Tag header, a Disallow: / robots.txt and a
# 404 on /llms.txt — so a preview host can never be indexed. Leave unset in
# production.
NEXT_PUBLIC_NOINDEX=""

# --- Enquiry delivery -------------------------------------------
# Until a provider is configured the app uses the console adapter, which
# logs that a submission occurred and nothing else. The UI never claims a
# message was delivered when it was not.
ENQUIRY_TRANSPORT="console"          # console | resend
RESEND_API_KEY=""
ENQUIRY_TO_EMAIL=""
ENQUIRY_FROM_EMAIL=""

# --- Analytics ----------------------------------------------------
# One Google Tag Manager container, e.g. "GTM-ABC1234". Everything else —
# GA4, call tracking, Ads conversions — is added inside GTM's own UI, so a
# measurement change never needs a deploy.
#
# Blank means analytics renders nothing at all: no script, no requests, no
# cookies. Leave it blank locally so development traffic is never counted,
# and scope it to Production on Vercel so preview deployments do not either.
#
# Server-only, like SITE_URL: the root layout is a server component and passes
# the id down as a prop, so it never needs inlining into a browser bundle.
GTM_ID=""
